{
  "name": "biance-vision",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "description": "币安大盘监控终端：实时行情、K线、价格突破与涨跌幅预警推送",
  "workspaces": [
    "server",
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:server": "pnpm --filter biance-vision-server run dev",
    "dev:web": "pnpm --filter biance-vision-web run dev",
    "dev:worker": "pnpm --filter biance-vision-server run worker",
    "user:add": "tsx scripts/add-user.ts",
    "user:passwd": "tsx scripts/passwd.ts",
    "brooks:selftest": "tsx scripts/brooks-selftest.ts",
    "quote-guide:selftest": "tsx scripts/quote-guide-selftest.ts",
    "market:smoke": "tsx scripts/market-ingest-smoke.ts",
    "build": "pnpm --filter biance-vision-brooks run build && pnpm --filter biance-vision-server run build && pnpm --filter biance-vision-web run build",
    "typecheck": "pnpm --filter biance-vision-brooks run build && tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "start": "pnpm --filter biance-vision-server run start",
    "brooks:causality": "tsx scripts/causality-check.ts",
    "chat:policy-check": "tsx scripts/chat-policy-check.ts",
    "research:calc-check": "tsx scripts/perp-event-calc-check.ts",
    "admin:gate-check": "tsx scripts/admin-gate-check.ts",
    "login:regression": "tsx scripts/login-regression.ts",
    "research:p1-check": "tsx scripts/p1-regression-check.ts",
    "eval:conversations": "tsx scripts/eval-conversations.ts",
    "knowledge:smoke": "tsx scripts/knowledge-smoke.ts",
    "knowledge:access-check": "tsx scripts/knowledge-access-check.ts",
    "offline:parse": "tsx scripts/offline-parse.ts",
    "research:smoke": "tsx scripts/research-smoke.ts",
    "vector:smoke": "tsx scripts/vector-smoke.ts",
    "release:gate": "tsx scripts/release-gate.ts",
    "linkage:smoke": "tsx scripts/linkage-smoke.ts",
    "web:smoke": "tsx scripts/web-search-smoke.ts",
    "geo:update": "tsx scripts/update-cn-ip-list.ts",
    "p0:db-check": "tsx scripts/p0-db-acceptance.ts",
    "blobs:migrate": "tsx scripts/migrate-blobs-to-minio.ts",
    "check:i18n": "tsx scripts/check-i18n.ts"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "fastify": "^4.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}