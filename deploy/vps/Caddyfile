# DuckStrat production routing: public site + user terminal, isolated admin entry.
# CSP is owned by Next; keep the user API / SPA policy independent.
duckstrat.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	route {
		@admin path /admin /admin/* /api/admin /api/admin/*
		respond @admin 404
		@toolSlash path_regexp toolSlash ^/(dashboard|research|brooks|movers|alerts|login|register)/$
		redir @toolSlash /{re.toolSlash.1}?{query} 308
		@tools path /dashboard /research /brooks /movers /alerts /login /register
		handle @tools {
			header X-Robots-Tag "noindex, nofollow"
			reverse_proxy 127.0.0.1:3200 {
				flush_interval -1
				header_up X-Forwarded-For {remote_host}
				header_up X-Real-IP {remote_host}
			}
		}
		@backend path /api /api/* /ws /assets/*
		handle @backend {
			header X-Robots-Tag "noindex, nofollow"
			reverse_proxy 127.0.0.1:3200 {
				flush_interval -1
				header_up X-Forwarded-For {remote_host}
				header_up X-Real-IP {remote_host}
			}
		}
		# /、/en、/zh、/_next/*、SEO 与品牌资源、所有未知路径归官网。
		handle {
			reverse_proxy 127.0.0.1:3100 {
				header_up X-Website-Client-IP {remote_host}
			}
		}
	}
}

admin.duckstrat.com {
	encode zstd gzip
	redir / /admin 302
	basic_auth {
		bvadmin <替换为caddy-hash-password生成的bcrypt哈希>
	}
	reverse_proxy 127.0.0.1:3201 {
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
	}
}

# Keep canonical redirects for bookmarks and historical search links.
www.duckstrat.com {
    redir https://duckstrat.com{uri} permanent
}

btcpilot.duckdns.org {
    redir https://duckstrat.com{uri} permanent
}

btcpilot-admin.duckdns.org {
    redir https://admin.duckstrat.com{uri} permanent
}
