{
  "name": "biance-vision-server",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8",
    "@fastify/static": "^7",
    "@biance/platform-contracts": "workspace:*",
    "@fastify/websocket": "^8.3.1",
    "biance-vision-brooks": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "^4.28.1",
    "pg-boss": "^10",
    "postgres": "3.4.9",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "@biance/brand": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
