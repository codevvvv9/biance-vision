# 复制为 .env 使用；默认值与 docker-compose.yml 对应，本机 docker compose up -d 后无需修改
DATABASE_URL=postgresql://biance_app:biance_app@127.0.0.1:5434/biance_vision

# 可选：服务端口（默认 3200）
# PORT=3200

# research-py Python 研究服务（文档解析 Docling / 模型训练推理）；docker compose up -d research-py 后默认即可
# RESEARCH_PY_URL=http://127.0.0.1:8100

# pg-boss 队列 schema（默认 pgboss）
# QUEUE_SCHEMA=pgboss

# 知识库 embedding/rerank 能力：正式配置入口是超管登录后的「Agent 配置域」页面
# （/admin/agents → 能力配置，持久化在 app_settings.agent_capabilities），
# 此处环境变量仅作无库开发时的注入覆盖：
# EMBEDDING_BASE_URL=...
# EMBEDDING_MODEL=...
# EMBEDDING_SECRET_REF=embedding   # 密钥读 server/data/secrets.json 的同名引用，或环境变量 EMBEDDING_API_KEY
# 离线验证向量链路：先 node scripts/mock-embeddings.mjs，再设
# EMBEDDING_BASE_URL=http://127.0.0.1:8123  EMBEDDING_MODEL=mock-bow-1536  EMBEDDING_API_KEY=mock
# 配好后跑 pnpm vector:smoke 验证（pgvector 未启用/embedding 未配置时自动 SKIP）

# MinIO 对象存储（知识库原始文件）；四项齐备时启用 S3 实现，否则落本地磁盘 server/data/knowledge-files/
# docker compose up -d minio 后本机开发可用：
# MINIO_ENDPOINT=http://127.0.0.1:9110
# MINIO_ACCESS_KEY=biance_minio
# MINIO_SECRET_KEY=biance_minio_secret
# MINIO_BUCKET=biance-knowledge

# 地域封锁（面向海外运营，默认屏蔽中国大陆来源 IPv4；名单 pnpm geo:update 生成）
# GEO_BLOCK_CN=on            # off 关闭
# GEO_BLOCK_ALLOW=           # 白名单，逗号分隔 IP/CIDR（运营者自用出口 IP）
# GEO_BLOCK_CN_LIST=         # 名单文件路径覆盖（默认 server/data/cn-ip-list.txt）
