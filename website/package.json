{
  "name": "@biance/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "tsx scripts/check-content.ts && next build",
    "start": "node --import ./runtime/access-log.mjs ./node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter biance-vision-brooks build && tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check:release": "tsx scripts/check-release.ts",
    "check:content": "tsx scripts/check-content.ts"
  },
  "dependencies": {
    "@biance/brand": "workspace:*",
    "@mdx-js/loader": "^3",
    "@mdx-js/react": "^3",
    "@next/mdx": "16.4.2",
    "@types/mdx": "^2",
    "next": "16.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "biance-vision-brooks": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.5.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  }
}
