# Canonical public origin. Set the real HTTPS domain before release.
WEBSITE_ORIGIN=http://localhost:3100
# At least one genuine contact is required for `pnpm check:release`.
WEBSITE_TELEGRAM=
WEBSITE_CONTACT_EMAIL=codevvvv9@gmail.com
# Optional verified client IPv4 fallback, supplied only by your trusted proxy.
# If omitted or unavailable, the root entry uses Accept-Language, then English.
WEBSITE_CN_IP_LIST=

# Only this public directory is shared read-only with the website.
WEBSITE_PUBLIC_CONFIG_DIR=
# Set only behind the trusted Caddy proxy; never expose the Next port publicly.
WEBSITE_TRUST_PROXY=0
