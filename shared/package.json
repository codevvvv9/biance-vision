{
  "name": "biance-vision-brooks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Al Brooks 价格行为结构引擎（纯 TS 零依赖，web 与 server 共用）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./polling": {
      "types": "./dist/polling.d.ts",
      "default": "./dist/polling.js"
    },
    "./membership": {
      "types": "./dist/contract/membership.d.ts",
      "default": "./dist/contract/membership.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^3.23.8"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
